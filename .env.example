# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== Webhook 通知（可选）=====
# 当报告生成、模拟完成等事件发生时，向外部端点发送 HTTP POST
WEBHOOK_URL=https://your-endpoint.example.com/mirofish-events
WEBHOOK_SECRET=your_hmac_signing_secret_here

# ===== Web Scraper 配置（可选）=====
# 基于 Scrapling 的自适应爬虫，支持绕过反爬（Cloudflare等）
# 安装: pip install scrapling
# 动态模式需要额外安装 Playwright: playwright install chromium
SCRAPER_MAX_TEXT_PER_PAGE=50000
SCRAPER_DEFAULT_MODE=auto

# ===== Canopy 团队协作集成（可选）=====
# Canopy 是本地优先的加密P2P工作区（Slack替代品），用于团队共享预测报告
# 参考: https://github.com/icojerrel/Canopy
# 1. 启动 Canopy 实例: python -m canopy
# 2. 在 Canopy UI 中创建 API Key（Settings → API Keys）
# 3. 复制目标频道 ID（频道设置中可见）
CANOPY_BASE_URL=http://localhost:7770
CANOPY_API_KEY=your_canopy_api_key_here
CANOPY_CHANNEL_ID=your_channel_id_here
CANOPY_POLL_INTERVAL=30